# ─── Server ───────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database ─────────────────────────────────────
DATABASE_URL="postgresql://postgres:*********@localhost:5432/scb_epcms

# ─── JWT ──────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=8h

# ─── CORS ─────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Rate Limiter ─────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
